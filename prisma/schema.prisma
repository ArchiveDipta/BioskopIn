// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

// ==============================
// NEXTAUTH MODELS
// ==============================
model Account {
  id Int @id @default(autoincrement())
  userId Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id Int @id @default(autoincrement())
  sessionToken String   @unique
  userId Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  CUSTOMER
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Optional if using Google Login
  role          Role      @default(USER)
  
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  seatHolds     SeatHold[]
  reviews       Review[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==============================
// BIOSKOP MODELS (PRD)
// ==============================
model Movie {
  id Int @id @default(autoincrement())
  title       String
  description String?    @db.Text
  duration    Int        // in minutes
  posterUrl   String?
  trailerUrl  String?
  category    String?    // e.g., Action, Drama, Slice of Life
  ageRating   String?    // e.g., SU, R13+, R18+
  showtimes   Showtime[]
  reviews     Review[]
}

model Cinema {
  id Int @id @default(autoincrement())
  name        String
  city        String
  address     String?
  studios     Studio[]
}

model Studio {
  id            Int     @id @default(autoincrement())
  cinemaId Int
  name          String
  totalCapacity Int
  
  cinema        Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats         Seat[]
  showtimes     Showtime[]
}

model Seat {
  id Int @id @default(autoincrement())
  studioId Int
  row       String        // e.g. 'A', 'B'
  number    Int           // e.g. 1, 2
  
  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tickets   OrderTicket[]
  seatHolds SeatHold[]

  // Aturan Ketat: Tidak boleh ada kursi ganda di studio yang sama
  @@unique([studioId, row, number])
}

model Showtime {
  id Int @id @default(autoincrement())
  movieId Int
  studioId Int
  startTime DateTime
  price     Float
  
  movie     Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tickets   OrderTicket[]
  seatHolds SeatHold[]
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Order {
  id          Int           @id @default(autoincrement())
  userId      Int
  totalPrice  Float
  status      OrderStatus   @default(PENDING)
  bookingCode String        @unique // 8 characters random string
  isCheckedIn Boolean       @default(false)
  checkedInAt DateTime?
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets     OrderTicket[]
  foodItems   OrderFoodItem[]
}

model OrderTicket {
  id Int @id @default(autoincrement())
  orderId Int
  showtimeId Int
  seatId Int
  price      Float
  
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  // Aturan Sangat Ketat (Pencegahan Double-Booking)
  @@unique([showtimeId, seatId]) 
}

// ==============================
// FITUR 3: SEAT HOLD (TIMER 10 MENIT)
// ==============================
model SeatHold {
  id         Int      @id @default(autoincrement())
  userId     Int
  showtimeId Int
  seatId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
}

// ==============================
// FITUR 4: MAKANAN & MINUMAN (F&B)
// ==============================
model FoodItem {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  price       Float
  imageUrl    String?
  category    String          // e.g. 'SNACK', 'BEVERAGE', 'COMBO'
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())

  orderItems  OrderFoodItem[]
}

model OrderFoodItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  foodItemId Int
  quantity   Int
  price      Float

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
}

// ==============================
// FITUR 5: RATING & ULASAN FILM
// ==============================
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int      // 1 sampai 5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}
