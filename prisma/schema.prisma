// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================
// NEXTAUTH MODELS
// ==============================
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Optional if using Google Login
  role          Role      @default(CUSTOMER)
  
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==============================
// BIOSKOP MODELS (PRD)
// ==============================
model Movie {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  duration    Int        // in minutes
  posterUrl   String?
  trailerUrl  String?
  showtimes   Showtime[]
}

model Studio {
  id            String     @id @default(cuid())
  name          String
  totalCapacity Int
  seats         Seat[]
  showtimes     Showtime[]
}

model Seat {
  id        String        @id @default(cuid())
  studioId  String
  row       String        // e.g. 'A', 'B'
  number    Int           // e.g. 1, 2
  
  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tickets   OrderTicket[]

  // Aturan Ketat: Tidak boleh ada kursi ganda di studio yang sama
  @@unique([studioId, row, number])
}

model Showtime {
  id        String        @id @default(cuid())
  movieId   String
  studioId  String
  startTime DateTime
  price     Float
  
  movie     Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tickets   OrderTicket[]
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Order {
  id          String        @id @default(cuid())
  userId      String
  totalPrice  Float
  status      OrderStatus   @default(PENDING)
  bookingCode String        @unique // 8 characters random string
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets     OrderTicket[]
}

model OrderTicket {
  id         String   @id @default(cuid())
  orderId    String
  showtimeId String
  seatId     String
  price      Float
  
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  // Aturan Sangat Ketat (Pencegahan Double-Booking)
  @@unique([showtimeId, seatId]) 
}
